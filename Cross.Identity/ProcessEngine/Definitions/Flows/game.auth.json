{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserName", "type": "String", "required": true },
          { "key": "Code", "type": "String", "required": true, "min": 4, "max": 8 }
        ]
      },
      "next": "codeAuth"
    },
    {
      "kind": "codeAuth",
      "channel": "email",
      "identityKey": "collectForm.UserName",
      "codeKey": "collectForm.Code",
      "resolveBy": { "field": "UserName" },
      "next": "issueJwt"
    },
    {
      "kind": "issueJwt",
      "lifetimeSeconds": 43200,
      "subKey": "codeAuth.UserId",
      "claims": { "scope": "game.player", "amr": "email_code" },
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "token": "issueJwt.Token",
        "email": "collectForm.Email"
      }
    }
  ]
}
