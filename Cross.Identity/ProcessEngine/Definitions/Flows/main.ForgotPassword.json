{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Email", "type": "Email", "required": false, "min": 8, "max": 128 },
          { "key": "PhoneNumber", "type": "PhoneNumber", "required": false, "max": 16 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ],
        "validators": [
          { "kind": "atLeastOneRequired", "fields": ["Email", "PhoneNumber"], "message": "Provide an email or a phone number." }
        ]
      },
      "selector": {
        "candidates": ["Email", "PhoneNumber"]
      },
      "next": "forgotPassword"
    },
    {
      "kind": "forgotPassword",
      "channel": "email",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "LastCode": "forgotPassword.LastCode"
      },
      "next": null
    }
  ]
}
