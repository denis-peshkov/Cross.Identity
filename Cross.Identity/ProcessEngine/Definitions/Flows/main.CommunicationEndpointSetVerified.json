{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserAccountId", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "Email", "type": "Email", "required": false, "min": 8, "max": 128 },
          { "key": "PhoneNumber", "type": "PhoneNumber", "required": false, "max": 16 },
          { "key": "Code", "type": "String", "required": true, "min": 4, "max": 16 },
          { "key": "LanguageCode", "type": "String", "required": false, "min": 2, "max": 2, "regex": "^[a-zA-Z]{2}$" },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ],
        "validators": [
          { "kind": "exactlyOneRequired", "fields": ["Email", "PhoneNumber"], "message": "Provide exactly one of Email or PhoneNumber." }
        ]
      },
      "next": "communicationEndpointSetVerified"
    },
    {
      "kind": "communicationEndpointSetVerified",
      "userAccountIdKey": "collectForm.UserAccountId",
      "emailKey": "collectForm.Email",
      "phoneKey": "collectForm.PhoneNumber",
      "codeKey": "collectForm.Code",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "endpoint": "communicationEndpointSetVerified.Endpoint",
        "channel": "communicationEndpointSetVerified.Channel",
        "address": "communicationEndpointSetVerified.Address",
        "verified": "communicationEndpointSetVerified.IsVerified"
      },
      "next": null
    }
  ]
}
