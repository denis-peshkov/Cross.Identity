{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserId", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "EndpointId", "type": "String", "required": true, "min": 36, "max": 36 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "communicationEndpointSetPreferred"
    },
    {
      "kind": "communicationEndpointSetPreferred",
      "userIdKey": "collectForm.UserId",
      "endpointIdKey": "collectForm.EndpointId",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "preferred": "communicationEndpointSetPreferred.Preferred"
      },
      "next": null
    }
  ]
}
