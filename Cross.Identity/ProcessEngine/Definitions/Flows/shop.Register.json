{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Email", "type": "Email", "required": true },
          { "key": "UserName", "type": "String", "required": true, "min": 3, "max": 32 },
          { "key": "FirstName", "type": "String", "required": false, "max": 64 },
          { "key": "LastName", "type": "String", "required": false, "max": 64 },
          { "key": "Phone", "type": "Phone", "required": true }
        ]
      },
      "next": "sendCode"
    },
    {
      "kind": "sendCode",
      "channel": "phone",
      "selectorKey": "registration.Phone",
      "next": "collectForm"
    },
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Phone", "type": "Phone", "required": true },
          { "key": "Code", "type": "String", "required": true, "min": 4, "max": 8 }
        ]
      },
      "next": "verifyCode"
    },
    {
      "kind": "verifyCode",
      "channel": "phone",
      "identityKey": "verification.Phone",
      "codeKey": "verification.Code",
      "next": "createUser"
    },
    {
      "kind": "createUser",
      "map": {
        "Email": "registration.Email",
        "UserName": "registration.UserName",
        "FirstName": "registration.FirstName",
        "LastName": "registration.LastName",
        "Phone": "registration.Phone"
      },
      "next": "issueJwt"
    },
    {
      "kind": "issueJwt",
      "lifetimeSeconds": 1209600,
      "subKey": "user.Id",
      "claims": { "scope": "shop.customer", "amr": "sms_code" }
    }
  ]
}
