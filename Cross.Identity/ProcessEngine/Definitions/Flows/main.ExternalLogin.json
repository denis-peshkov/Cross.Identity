{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserAccountId", "type": "String", "required": false, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "Provider", "type": "String", "required": true, "min": 2, "max": 32 },
          { "key": "ReturnUrl", "type": "String", "required": false, "max": 512 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "externalLoginInitiate"
    },
    {
      "kind": "externalLoginInitiate",
      "providerKey": "collectForm.Provider",
      "returnUrlKey": "collectForm.ReturnUrl",
      "userAccountIdKey": "collectForm.UserAccountId",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "url": "externalLoginInitiate.Url"
      },
      "next": null
    }
  ]
}
