{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserAccountId", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "MergeToken", "type": "String", "required": true, "min": 16, "max": 64 },
          { "key": "LanguageCode", "type": "String", "required": false, "min": 2, "max": 2, "regex": "^[a-zA-Z]{2}$" },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "externalLoginMerge"
    },
    {
      "kind": "externalLoginMerge",
      "mergeTokenKey": "collectForm.MergeToken",
      "userAccountIdKey": "collectForm.UserAccountId",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "survivor_user_account_id": "externalLoginMerge.SurvivorUserAccountId",
        "absorbed_user_account_id": "externalLoginMerge.AbsorbedUserAccountId",
        "moved_providers": "externalLoginMerge.MovedProviders"
      },
      "next": null
    }
  ]
}
