{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "communicationEndpointsGetAll"
    },
    {
      "kind": "communicationEndpointsGetAll",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "endpoints": "communicationEndpointsGetAll.Endpoints"
      },
      "next": null
    }
  ]
}
