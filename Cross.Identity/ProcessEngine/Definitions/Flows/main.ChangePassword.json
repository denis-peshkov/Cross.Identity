{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Id", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "CurrentPassword", "type": "Password", "required": true, "min": 8, "max": 128 },
          { "key": "NewPassword", "type": "Password", "required": true, "min": 8, "max": 128 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "selector": {
        "candidates": ["Id"]
      },
      "next": "passwordAuth"
    },
    {
      "kind": "passwordAuth",
      "passwordKey": "collectForm.CurrentPassword",
      "next": "resetPassword"
    },
    {
      "kind": "resetPassword",
      "channel": "email",
      "passwordKey": "collectForm.NewPassword",
      "ipAddressKey": "collectForm.IpAddress",
      "userAgentKey": "collectForm.UserAgent",
      "deviceFingerprint": "collectForm.DeviceFingerprint",
      "next": null
    }
  ]
}
