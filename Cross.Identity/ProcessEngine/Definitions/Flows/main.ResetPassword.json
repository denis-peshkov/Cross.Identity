{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Email", "type": "Email", "required": false, "min": 8, "max": 128 },
          { "key": "PhoneNumber", "type": "PhoneNumber", "required": false, "max": 16 },
          { "key": "UserName", "type": "String", "required": false, "min": 3, "max": 64 },
          { "key": "Code", "type": "String", "required": true, "min": 8, "max": 128 },
          { "key": "Password", "type": "Password", "required": true, "min": 8, "max": 128 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ],
        "validators": [
          { "kind": "atLeastOneRequired", "fields": ["Email", "PhoneNumber", "UserName"], "message": "Provide an email, phone, or user name." }
        ]
      },
      "selector": {
        "candidates": ["Email", "PhoneNumber", "UserName"]
      },
      "next": "verifyCode"
    },
    {
      "kind": "verifyCode",
      "channel": "email",
      "codeKey": "collectForm.Code",
      "next": "resetPassword"
    },
    {
      "kind": "resetPassword",
      "channel": "email",
      "passwordKey": "collectForm.Password",
      "ipAddressKey": "collectForm.IpAddress",
      "userAgentKey": "collectForm.UserAgent",
      "deviceFingerprint": "collectForm.DeviceFingerprint",
      "next": null
    }
  ]
}
