{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Email", "type": "Email", "required": false, "min": 8, "max": 128 },
          { "key": "PhoneNumber", "type": "PhoneNumber", "required": false, "max": 16 },
          { "key": "UserName", "type": "String", "required": false, "min": 3, "max": 64 },
          { "key": "Password", "type": "Password", "required": false, "min": 8, "max": 32 },
          { "key": "Code", "type": "String", "required": false, "min": 6, "max": 12 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ],
        "validators": [
          { "kind": "atLeastOneRequired", "fields": ["Email", "PhoneNumber", "UserName"], "message": "Provide an email, phone, or user name." },
          { "kind": "requiredIf", "when": { "field": "Code", "equals": "" }, "then": { "name": "Password", "required": true }, "message": "Provide a password or a code." },
          { "kind": "requiredIf", "when": { "field": "Password", "equals": "" }, "then": { "name": "Code", "required": true }, "message": "Provide a password or a code." },
          { "kind": "atLeastOneRequired", "fields": ["Password", "Code"], "message": "Provide at least a password or a code." }
        ]
      },
      "selector": {
        "candidates": ["Email", "PhoneNumber", "UserName"]
      },
      "next": "token"
    },
    {
      "kind": "token",
      "passwordKey": "collectForm.Password",
      "codeKey": "collectForm.Code",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "access_token": "token.AccessToken",
        "refresh_token": "token.RefreshToken",
        "token_type": "token.TokenType",
        "expires_in": "token.ExpiresIn",
        "user_id": "token.UserAccountId"
      },
      "next": null
    }
  ]
}
