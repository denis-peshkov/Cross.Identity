{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Phone", "type": "Phone", "required": true },
          { "key": "Code", "type": "String", "required": true, "min": 4, "max": 8 }
        ]
      },
      "next": "codeAuth"
    },
    {
      "kind": "codeAuth",
      "channel": "phone",
      "identityKey": "auth.Phone",
      "codeKey": "auth.Code",
      "resolveBy": { "field": "Phone" },
      "next": "issueJwt"
    },
    {
      "kind": "issueJwt",
      "lifetimeSeconds": 43200,
      "subKey": "user.Id",
      "claims": { "scope": "shop.customer", "amr": "sms_code" }
    }
  ]
}
