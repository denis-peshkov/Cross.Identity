{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Email", "type": "Email", "required": true },
          { "key": "Password", "type": "Password", "required": true, "min": 8, "max": 128 }
        ]
      },
      "schemaPatch": {
        "add": [
          { "key": "OtpCode", "type": "String", "required": true, "min": 4, "max": 8 }
        ]
      },
      "next": "passwordAuth"
    },
    {
      "kind": "passwordAuth",
      "selectorField": "Email",
      "selectorKey": "auth.Email",
      "passwordKey": "auth.Password",
      "next": "verifyCode"
    },
    {
      "kind": "verifyCode",
      "channel": "email",
      "identityKey": "auth.Email",
      "codeKey": "auth.OtpCode",
      "next": "issueJwt"
    },
    {
      "kind": "issueJwt",
      "lifetimeSeconds": 28800,
      "subKey": "user.Id",
      "claims": { "scope": "license.portal", "amr": "pwd+otp" }
    }
  ]
}
