{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "RefreshToken", "type": "String", "required": true, "min": 32, "max": 2048 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 }
        ]
      },
      "next": "logoutAll"
    },
    {
      "kind": "logoutAll",
      "refreshTokenKey": "collectForm.RefreshToken",
      "ipAddressKey": "collectForm.IpAddress",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "revoked": "logoutAll.Revoked"
      },
      "next": null
    }
  ]
}
