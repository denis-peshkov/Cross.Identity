{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserAccountId", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "Email", "type": "String", "required": true, "min": 5, "max": 320 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "changeAccountEmail"
    },
    {
      "kind": "changeAccountEmail",
      "userAccountIdKey": "collectForm.UserAccountId",
      "emailKey": "collectForm.Email",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "email": "changeAccountEmail.Email",
        "email_verified": "changeAccountEmail.EmailVerified",
        "endpoint": "changeAccountEmail.Endpoint"
      },
      "next": null
    }
  ]
}
