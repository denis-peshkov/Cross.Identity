{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "AccessToken", "type": "String", "required": true, "max": 2048 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "verifyToken"
    },
    {
      "kind": "verifyToken",
      "accessTokenKey": "collectForm.AccessToken",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "valid": "verifyToken.Valid",
        "user_id": "verifyToken.UserAccountId",
        "jti": "verifyToken.Jti"
      },
      "next": null
    }
  ]
}
