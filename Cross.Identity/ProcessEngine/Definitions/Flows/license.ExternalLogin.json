{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Provider", "type": "String", "required": true, "min": 2, "max": 32 },
          { "key": "ReturnUrl", "type": "String", "required": false, "max": 512 }
        ]
      },
      "next": "initiateExternalLogin"
    },
    {
      "kind": "initiateExternalLogin",
      "providerKey": "collectForm.Provider",
      "returnUrlKey": "collectForm.ReturnUrl",
      "linkUserIdKey": "LinkUserId",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "url": "initiateExternalLogin.Url"
      },
      "next": null
    }
  ]
}
