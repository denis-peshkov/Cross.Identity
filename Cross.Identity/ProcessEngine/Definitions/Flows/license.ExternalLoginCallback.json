{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Code", "type": "String", "required": true, "min": 1, "max": 2048 },
          { "key": "State", "type": "String", "required": true, "min": 1, "max": 4096 },
          { "key": "Error", "type": "String", "required": false, "max": 256 },
          { "key": "ErrorDescription", "type": "String", "required": false, "max": 1024 }
        ]
      },
      "next": "completeExternalLogin"
    },
    {
      "kind": "completeExternalLogin",
      "codeKey": "collectForm.Code",
      "stateKey": "collectForm.State",
      "errorKey": "collectForm.Error",
      "errorDescriptionKey": "collectForm.ErrorDescription",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "access_token": "completeExternalLogin.AccessToken",
        "refresh_token": "completeExternalLogin.RefreshToken",
        "token_type": "completeExternalLogin.TokenType",
        "expires_in": "completeExternalLogin.ExpiresIn",
        "user_id": "completeExternalLogin.UserId",
        "is_linking": "completeExternalLogin.IsLinking"
      },
      "next": null
    }
  ]
}
