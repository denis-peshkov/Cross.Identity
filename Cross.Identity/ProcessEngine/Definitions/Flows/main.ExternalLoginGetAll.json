{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "UserAccountId", "type": "String", "required": true, "min": 36, "max": 36, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          { "key": "RefreshToken", "type": "String", "required": true, "min": 32, "max": 2048 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 },
          { "key": "DeviceFingerprint", "type": "String", "required": false, "max": 128 }
        ]
      },
      "next": "externalLoginGetAll"
    },
    {
      "kind": "externalLoginGetAll",
      "userAccountIdKey": "collectForm.UserAccountId",
      "refreshTokenKey": "collectForm.RefreshToken",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "account_email": "externalLoginGetAll.AccountEmail",
        "providers": "externalLoginGetAll.Providers"
      },
      "next": null
    }
  ]
}
