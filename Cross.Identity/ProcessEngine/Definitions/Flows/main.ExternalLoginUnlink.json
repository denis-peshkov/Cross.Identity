{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Provider", "type": "String", "required": true, "min": 2, "max": 32 }
        ]
      },
      "next": "externalLoginUnlink"
    },
    {
      "kind": "externalLoginUnlink",
      "providerKey": "collectForm.Provider",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "unlinked": "externalLoginUnlink.Unlinked"
      },
      "next": null
    }
  ]
}
