{
  "start": "collectForm",
  "steps": [
    {
      "kind": "collectForm",
      "schemaDef": {
        "fields": [
          { "key": "Code", "type": "String", "required": false, "min": 1, "max": 2048 },
          { "key": "State", "type": "String", "required": true, "min": 1, "max": 4096 },
          { "key": "Error", "type": "String", "required": false, "max": 256 },
          { "key": "ErrorDescription", "type": "String", "required": false, "max": 1024 },
          { "key": "IpAddress", "type": "String", "required": false, "max": 64 },
          { "key": "UserAgent", "type": "String", "required": false, "max": 512 }
        ],
        "validators": [
          { "kind": "requiredIf", "when": { "field": "Error", "equals": "" }, "then": { "name": "Code", "required": true }, "message": "Provide an authorization code or an OAuth error." },
          { "kind": "requiredIf", "when": { "field": "Code", "equals": "" }, "then": { "name": "Error", "required": true }, "message": "Provide an authorization code or an OAuth error." },
          { "kind": "atLeastOneRequired", "fields": ["Code", "Error"], "message": "Provide an authorization code or an OAuth error." }
        ]
      },
      "next": "externalLoginComplete"
    },
    {
      "kind": "externalLoginComplete",
      "codeKey": "collectForm.Code",
      "stateKey": "collectForm.State",
      "errorKey": "collectForm.Error",
      "errorDescriptionKey": "collectForm.ErrorDescription",
      "ipAddressKey": "collectForm.IpAddress",
      "userAgentKey": "collectForm.UserAgent",
      "next": "collectResult"
    },
    {
      "kind": "collectResult",
      "map": {
        "access_token": "externalLoginComplete.AccessToken",
        "refresh_token": "externalLoginComplete.RefreshToken",
        "token_type": "externalLoginComplete.TokenType",
        "expires_in": "externalLoginComplete.ExpiresIn",
        "user_id": "externalLoginComplete.UserId",
        "is_linking": "externalLoginComplete.IsLinking"
      },
      "next": null
    }
  ]
}
