<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cross.Identity</id>
    <version>0.0.0</version>
    <authors>Denis Peshkov</authors>
    <owners>Denis Peshkov</owners>
    <copyright>Copyright Denis Peshkov</copyright>
    <projectUrl>https://github.com/denis-peshkov/Cross.Identity</projectUrl>
    <repository type="git" url="https://github.com/denis-peshkov/Cross.Identity.git" />
    <description>Identity and authentication library for .NET: configurable flows (registration, login, forgot password, token, refresh), JWT, Argon2, email/SMS verification, process engine with JSON-defined flows.</description>
    <tags>Identity Authentication JWT Argon2 Registration Login ForgotPassword Token RefreshToken ProcessEngine Flows Email Sms Verification NetCore AspNetCore</tags>
    <icon>IdentityServer.png</icon>
    <readme>README.md</readme>
    <license type="file">LICENSE.md</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes><![CDATA[
Cross.Identity: identity and authentication flows, JWT, process engine.
]]></releaseNotes>
    <dependencies>
      <dependency id="Cross.ErrorHandlers" version="7.3.0" />
      <dependency id="Cross.Headers" version="1.0.0" />
      <dependency id="Konscious.Security.Cryptography.Argon2" version="1.3.1" />
      <dependency id="Magick.NET.Core" version="13.6.0" />
      <dependency id="Microsoft.EntityFrameworkCore" version="8.0.8" />
      <dependency id="Microsoft.EntityFrameworkCore.Relational" version="8.0.8" />
      <dependency id="Microsoft.Extensions.Http" version="8.0.0" />
      <dependency id="PhoneNumbersCore" version="1.1.1" />
      <dependency id="System.IdentityModel.Tokens.Jwt" version="7.1.2" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Cross.Identity\bin\Release\net8.0\Cross.Identity*.*" target="lib\net8.0" />
    <file src="..\LICENSE.md" target="" />
    <file src="..\README.md" target="" />
    <file src="..\IdentityServer.png" target="" />
  </files>
</package>
