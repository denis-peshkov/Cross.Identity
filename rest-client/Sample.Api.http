###
# Cross.Identity Sample.Api — manual E2E for `main/*` flows (FlowOperationEnum values).
#
# Prerequisite:
#   dotnet run --project Sample.Api --launch-profile http
#   Swagger: {{HOST}}/swagger
#
# Run (IntelliJ / Cursor HTTP Client): select environment **sample** in the request gutter.
#   Variables: http-client.env.json + http-client.private.env.json (see .example).
#
# Notes:
#   Authentication:DeveloperMode=true — Register / RequestCode / ForgotPassword return LastCode in the body.
#   InMemory DB — data is lost on Sample.Api restart; run Register again before dependent calls.
#   After Register or Token — copy LastCode / refresh_token into http-client.private.env.json (gitignored) if needed.
#   OAuth (ExternalLogin / ExternalLoginCallback) — seed Providers in DB + appsettings; placeholders below.

### Register
# @name main-register
# @no-cookie-jar
POST {{HOST}}/api/identity/main/Register
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Password": "{{PASSWORD}}"
}

### Request Code
# @name main-request-code
POST {{HOST}}/api/identity/main/RequestCode
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Ttl": "{{TTL}}"
}

### Token
# @name main-token-password
POST {{HOST}}/api/identity/main/Token
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Password": "{{PASSWORD}}"
}

###
# @name main-token-code
POST {{HOST}}/api/identity/main/Token
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Code": "{{LAST_CODE}}"
}

###
# @name main-refresh-token
POST {{HOST}}/api/identity/main/RefreshToken
Content-Type: application/json

{
  "RefreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name main-get-user-id
POST {{HOST}}/api/identity/main/GetUserId
Content-Type: application/json

{
  "Email": "{{EMAIL}}"
}

###
# @name main-forgot-password
POST {{HOST}}/api/identity/main/ForgotPassword
Content-Type: application/json

{
  "Email": "{{EMAIL}}"
}

###
# @name main-reset-password
POST {{HOST}}/api/identity/main/ResetPassword
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Code": "{{LAST_CODE}}",
  "Password": "{{PASSWORD}}"
}

###
# @name main-external-login
POST {{HOST}}/api/identity/main/ExternalLogin
Content-Type: application/json

{
  "Provider": "Google",
  "ReturnUrl": "{{HOST}}/swagger"
}
# Optional account-link: "UserId": "<user-guid>", "RefreshToken": "<refresh_token for that user>"


###
# @name main-external-login-callback
POST {{HOST}}/api/identity/main/ExternalLoginCallback
Content-Type: application/json

{
  "Code": "<oauth-authorization-code>",
  "State": "<oauth-state-from-initiate>",
  "Error": "",
  "ErrorDescription": ""
}

###
# @name main-external-login-unlink
# Requires authenticated caller (Bearer ACCESS_TOKEN with sub = current user).
POST {{HOST}}/api/identity/main/ExternalLoginUnlink
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "Provider": "Google"
}

###
# @name main-logout
# Logout current session: revokes the presented refresh token (USER_LOGOUT). Idempotent.
POST {{HOST}}/api/identity/main/Logout
Content-Type: application/json

{
  "RefreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name main-logout-all
# Logout from all devices: presents a live refresh token, revokes all sessions (USER_LOGOUT_ALL).
POST {{HOST}}/api/identity/main/LogoutAll
Content-Type: application/json

{
  "RefreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name main-verify-token
# Verify access token is still valid in storage (not revoked / not expired).
POST {{HOST}}/api/identity/main/VerifyToken
Content-Type: application/json

{
  "AccessToken": "{{ACCESS_TOKEN}}"
}

###
# @name main-communication-endpoints-get-all
# UserId identifies the account (same pattern as ExternalLoginGetAll).
POST {{HOST}}/api/identity/main/CommunicationEndpointsGetAll
Content-Type: application/json

{
  "UserId": "{{USER_ID}}"
}

###
# @name main-communication-endpoint-set-preferred
# Sets the single preferred communication endpoint (must be verified).
POST {{HOST}}/api/identity/main/CommunicationEndpointSetPreferred
Content-Type: application/json

{
  "UserId": "{{USER_ID}}",
  "EndpointId": "{{ENDPOINT_ID}}"
}
