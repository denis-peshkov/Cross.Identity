###
# Cross.Identity Sample.Api — manual E2E for `main/*` flows (FlowOperationEnum values).
#
# Prerequisite:
#   dotnet run --project Sample.Api --launch-profile http
#   Swagger: {{HOST}}/swagger
#
# Run (IntelliJ / Cursor HTTP Client): select environment **sample** in the request gutter.
#   Variables: http-client.env.json + http-client.private.env.json (see .example).
#
# Notes:
#   Authentication:DeveloperMode=true — Register / RequestCode / ForgotPassword return LastCode in the body.
#   InMemory DB — data is lost on Sample.Api restart; run Register again before dependent calls.
#   After Register or Token — copy LastCode / refresh_token into http-client.private.env.json (gitignored) if needed.
#   OAuth (ExternalLogin / ExternalLoginCallback / ExternalLoginMerge) — seed Providers in DB + appsettings; placeholders below.

### Register
# @name main-register
# @no-cookie-jar
POST {{HOST}}/api/identity/main/Register
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Password": "{{PASSWORD}}"
}

### Request Code
# @name main-request-code
POST {{HOST}}/api/identity/main/RequestCode
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Ttl": "{{TTL}}"
}

### Token
# @name main-token-password
POST {{HOST}}/api/identity/main/Token
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Password": "{{PASSWORD}}"
}

###
# @name main-token-code
POST {{HOST}}/api/identity/main/Token
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Code": "{{LAST_CODE}}"
}

###
# @name main-refresh-token
# Client → host: RefreshToken (cookie/body). Host validates, resolves refresh Jti (RefreshTokens.Id), then ExecuteAsync({ Jti, … }).
POST {{HOST}}/api/identity/main/RefreshToken
Content-Type: application/json

{
  "RefreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name main-get-user-id
POST {{HOST}}/api/identity/main/GetUserAccountId
Content-Type: application/json

{
  "Email": "{{EMAIL}}"
}

###
# @name main-forgot-password
POST {{HOST}}/api/identity/main/ForgotPassword
Content-Type: application/json

{
  "Email": "{{EMAIL}}"
}

###
# @name main-reset-password
POST {{HOST}}/api/identity/main/ResetPassword
Content-Type: application/json

{
  "Email": "{{EMAIL}}",
  "Code": "{{LAST_CODE}}",
  "Password": "{{PASSWORD}}"
}

###
# @name main-external-login
POST {{HOST}}/api/identity/main/ExternalLogin
Content-Type: application/json

{
  "Provider": "Google",
  "ReturnUrl": "{{HOST}}/swagger"
}
# Optional account-link: "UserAccountId": "<user-guid>", "RefreshToken": "<refresh_token for that user>"


###
# @name main-external-login-callback
POST {{HOST}}/api/identity/main/ExternalLoginCallback
Content-Type: application/json

{
  "Code": "<oauth-authorization-code>",
  "State": "<oauth-state-from-initiate>",
  "Error": "",
  "ErrorDescription": ""
}

###
# @name main-external-login-unlink
POST {{HOST}}/api/identity/main/ExternalLoginUnlink
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "Provider": "Google"
}

###
# @name main-external-login-merge
# After link-mode ExternalLoginCallback returns ValidationException with mergeToken (alreadyLinked).
# Host authorizes UserAccountId = survivor before ExecuteAsync.
POST {{HOST}}/api/identity/main/ExternalLoginMerge
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "MergeToken": "{{MERGE_TOKEN}}"
}

###
# @name main-logout
# Client → host: AccessToken. Host validates, resolves Jti, then ExecuteAsync({ Jti, … }). Idempotent.
POST {{HOST}}/api/identity/main/Logout
Content-Type: application/json

{
  "AccessToken": "{{ACCESS_TOKEN}}"
}

###
# @name main-logout-all
# Client → host: AccessToken. Host validates, resolves UserAccountId (sub), then ExecuteAsync({ UserAccountId, … }).
POST {{HOST}}/api/identity/main/LogoutAll
Content-Type: application/json

{
  "AccessToken": "{{ACCESS_TOKEN}}"
}

###
# @name main-verify-token
# Verify access token is still valid in storage (not revoked / not expired).
POST {{HOST}}/api/identity/main/VerifyToken
Content-Type: application/json

{
  "AccessToken": "{{ACCESS_TOKEN}}"
}

###
# @name main-communication-endpoints-get-all
POST {{HOST}}/api/identity/main/CommunicationEndpointsGetAll
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "RefreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name main-communication-endpoint-set-preferred
# Sets the single preferred communication endpoint (must be verified).
POST {{HOST}}/api/identity/main/CommunicationEndpointSetPreferred
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "RefreshToken": "{{REFRESH_TOKEN}}",
  "EndpointId": "{{ENDPOINT_ID}}"
}

###
# @name main-change-account-email
# Change account primary email. Auto-verifies when Email matches a linked provider ProviderEmail.
POST {{HOST}}/api/identity/main/ChangeAccountEmail
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "Email": "new@example.com"
}

###
# @name main-communication-endpoint-add
# Secondary email/phone — step 1: ICommunicationEndpointService.AddAsync (unverified Manual) + OTP to that address.
# Provide exactly one of Email / PhoneNumber. Host must authorize UserAccountId.
# DeveloperMode may return LastCode in the response for local testing.
POST {{HOST}}/api/identity/main/CommunicationEndpointAdd
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "Email": "second@example.com",
  "Ttl": "00:05:00"
}

###
# @name main-communication-endpoint-set-verified
# Secondary email/phone — step 2: verify OTP, then ICommunicationEndpointService.SetVerifiedAsync.
# Same Email or PhoneNumber as in CommunicationEndpointAdd. Does not set preferred (use SetPreferred).
POST {{HOST}}/api/identity/main/CommunicationEndpointSetVerified
Content-Type: application/json

{
  "UserAccountId": "{{USER_ACCOUNT_ID}}",
  "Email": "second@example.com",
  "Code": "{{LAST_CODE}}"
}
