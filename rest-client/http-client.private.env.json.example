// IntelliJ IDEA / Cursor / WebStorm — secrets and session values for HTTP Client (rest-client/*.http).
//
// Usage:
//   1. Copy http-client.private.env.json.example → http-client.private.env.json
//   2. Replace placeholders below (file is gitignored — do not commit).
//   3. With http-client.env.json, pick **local** or **dev** in the gutter (Sample.Api.http).
//
// Variables merged with http-client.env.json (HOST, TTL — in the public file):
//   EMAIL — address used in Register / Token / RequestCode / etc.
//   PASSWORD — password for Register and password grant (Token).
//   LAST_CODE — DeveloperMode: LastCode from Register, RequestCode, or ForgotPassword response body.
//   REFRESH_TOKEN — refresh_token from Token or TokenByCode response (RefreshToken request).

{
  "local": {
    "EMAIL": "<your email for main flows>",
    "PASSWORD": "<your password for Register / Token>",
    "LAST_CODE": "<LastCode from Register / RequestCode / ForgotPassword>",
    "REFRESH_TOKEN": "<refresh_token from Token / TokenByCode>"
  },
  "dev": {
    "EMAIL": "<your email for main flows>",
    "PASSWORD": "<your password for Register / Token>",
    "LAST_CODE": "<LastCode from Register / RequestCode / ForgotPassword>",
    "REFRESH_TOKEN": "<refresh_token from Token / TokenByCode>"
  }
}
